{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "npm run lint 1>&2 || true",
            "statusMessage": "Lint (informativo, no bloquea)...",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "npx tsc --noEmit 1>&2; TSC_EXIT=$?; if [ $TSC_EXIT -ne 0 ]; then printf '{\"continue\":false,\"stopReason\":\"TypeScript tiene errores de tipos. Corrigelos antes de hacer git push.\"}'; fi",
            "statusMessage": "Verificando tipos TypeScript...",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*deploy.sh*)",
            "command": "ssh -i ~/.ssh/kyoszen_vps root@76.13.111.112 'pm2 list --no-color | grep kyoszen' 1>&2",
            "statusMessage": "Verificando PM2 en VPS post-deploy...",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python3 .claude/update-fecha.py 1>&2",
            "statusMessage": "Actualizando fecha en CLAUDE.md...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
